{
  "name": "runofflab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "serve": "node --import tsx scripts/server.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "evidence": "node --import tsx scripts/evaluate.ts",
    "data:pilot": "node --import tsx scripts/dataset.ts --pilot",
    "preview": "vite preview --host 127.0.0.1",
    "build:public": "tsc --noEmit && VITE_PUBLIC_BUILD=1 vite build --outDir dist-public --emptyOutDir"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "@fontsource/archivo": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "tsx": "^4.20.0",
    "@playwright/test": "1.64.1"
  }
}
